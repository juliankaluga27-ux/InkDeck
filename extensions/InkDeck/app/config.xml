<?xml version="1.0"?>
<widget id="com.codex.inkdeck" version="3.9.0" viewmodes="application" xmlns="http://www.w3.org/ns/widgets" xmlns:kindle="http://kindle.amazon.com/ns/widget-extensions">
  <name xml:lang="pl">InkDeck</name><description xml:lang="pl">Gry i narzędzia offline</description><content src="index.html" />
  <kindle:chrome><kindle:asset key="configureSearchBar" value="none" /></kindle:chrome>
  <kindle:gestures><kindle:param name="tap" value="yes" properties="fire_on_tap:1 max_updown_delta:0" /><kindle:param name="swipe" value="yes" /></kindle:gestures>
  <feature name="http://kindle.amazon.com/apis" required="true"><param name="appmgr" value="yes" /><param name="gestures" value="yes" /><param name="chrome" value="yes" /><param name="messaging" value="yes" /><param name="localprefs" value="yes" /><param name="device" value="yes" /></feature>
  <kindle:messaging><kindle:app name="com.lab126.mfa" value="yes" /></kindle:messaging>
  <kindle:resources><kindle:asset key="LocalStorageQuota" value="5242880" /></kindle:resources>
  <kindle:settings><kindle:setting name="internetRequired" value="no" /><kindle:setting name="saveContext" value="no" /><kindle:setting name="disable-wua-features" value="yes" /></kindle:settings>
</widget>
