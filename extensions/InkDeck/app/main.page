<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no"><title>InkDeck</title><link rel="stylesheet" href="style.css"></head><body>
<div id="top"><button id="back" class="small hidden">MENU</button><span id="title">INKDECK</span><button id="exit" class="small darkButton">WYJDŹ</button></div>
<button id="settingsCloseGlobal" class="hidden">✕ ZAMKNIJ USTAWIENIA</button>
<div id="menu" class="page active"><div class="hero"><img src="assets/inkdeck-logo.png" alt="InkDeck"><p>Gry, pisanie i narzędzia offline</p></div><div class="tabs"><button class="category selected" data-category="games">GRY</button><button class="category" data-category="tools">NARZĘDZIA</button><button class="category" data-category="plugins">PLUGINY</button></div><div id="menuItems">
<button class="menuButton" data-category="games" data-game="ttt">KÓŁKO I KRZYŻYK<span>bot lub dwie osoby</span></button><button class="menuButton" data-category="games" data-game="mine">SAPER<span>klasyczne zasady i bezpieczny start</span></button><button class="menuButton" data-category="games" data-game="g2048">2048<span>łącz kafelki</span></button><button class="menuButton" data-category="games" data-game="memory">PAMIĘĆ<span>odkrywaj pary</span></button><button class="menuButton" data-category="games" data-game="chess">SZACHY<span>roszada i en passant</span></button><button class="menuButton" data-category="games" data-game="checkers">WARCABY<span>bot lub dwie osoby</span></button><button class="menuButton" data-category="games" data-game="connect">CZTERY W RZĘDZIE<span>bot lub dwie osoby</span></button><button class="menuButton" data-category="games" data-game="lights">ZGAŚ ŚWIATŁA<span>łamigłówka 5 × 5</span></button><button class="menuButton" data-category="games" data-game="life">GRA W ŻYCIE<span>automat komórkowy Conwaya</span></button>
<button class="menuButton hidden" data-category="tools" data-game="writer">KINDLEWRITER<span>dokumenty z formatowaniem</span></button><button class="menuButton hidden" data-category="tools" data-game="draw">SZKICOWNIK<span>rysowanie palcem</span></button><button class="menuButton hidden" data-category="tools" data-game="todo">LISTA ZADAŃ<span>zapisywana na urządzeniu</span></button><button class="menuButton hidden" data-category="tools" data-game="calc">KALKULATOR<span>obliczenia offline</span></button><button class="menuButton hidden" data-category="tools" data-game="files">PLIKI PRZEZ WI-FI<span>wysyłanie z telefonu</span></button><button class="menuButton hidden" data-category="tools" data-game="updates">AKTUALIZACJE<span>sprawdź GitHub i zainstaluj</span></button><button class="menuButton hidden" data-category="plugins" data-game="plugins">MENEDŻER PLUGINÓW<span>własne gry i narzędzia</span></button></div></div>

<div id="ttt" class="page"><div class="bar"><span id="tttStatus"></span><button id="tttNew" class="small">NOWA</button></div><div class="gameControls"><button id="tttAI">Z KINDLE'EM</button><button id="tttTwo">2 OSOBY</button><select id="tttLevel" class="levelSelect"><option value="veryeasy">bardzo łatwy</option><option value="easy">łatwy</option><option value="medium" selected>średni</option><option value="hard">trudny</option></select></div><div id="tttBoard" class="tttBoard"></div></div>
<div id="mine" class="page"><div class="bar"><span id="mineStatus"></span><button id="mineNew" class="small">NOWA</button><button class="small settingsToggle" data-panel="mineSettings">USTAWIENIA</button></div><div id="mineSettings" class="settingsPanel hidden"><div class="mineOptions"><label>Plansza <select id="mineSize"><option value="8">8 × 8</option><option value="10" selected>10 × 10</option><option value="12">12 × 12</option></select></label><label>Miny <select id="mineCount"><option>5</option><option selected>10</option><option>15</option><option>20</option><option>25</option></select></label></div><p class="hint">Dotknij: odkryj. Przytrzymaj: flaga. Pierwsze pole i jego sąsiedzi są bezpieczne.</p></div><div id="mineBoard" class="mineBoard"></div></div>
<div id="g2048" class="page"><div class="bar"><span id="score2048"></span><button id="new2048" class="small">NOWA</button><button class="small settingsToggle" data-panel="g2048Settings">ZASADY</button></div><div id="g2048Settings" class="settingsPanel hidden"><p class="hint">Połącz dwa jednakowe kafelki. Celem jest uzyskanie 2048.</p></div><div id="board2048" class="board2048"></div><div class="arrows"><button id="move2048Up">↑ GÓRA</button><div><button id="move2048Left">← LEWO</button><button id="move2048Down">↓ DÓŁ</button><button id="move2048Right">PRAWO →</button></div></div></div>
<div id="memory" class="page"><div class="bar"><span id="memoryStatus"></span><button id="memoryNew" class="small">NOWA</button><button class="small settingsToggle" data-panel="memorySettings">USTAWIENIA</button></div><div id="memorySettings" class="settingsPanel hidden"><label class="option">Liczba par <select id="memoryPairsSelect"><option value="6">6</option><option value="8" selected>8</option><option value="10">10</option></select></label></div><div id="memoryBoard" class="memoryBoard"></div></div>
<div id="chess" class="page"><div class="bar"><span id="chessStatus"></span><button id="chessNew" class="small">NOWA</button><button class="small settingsToggle" data-panel="chessSettings">USTAWIENIA</button></div><div class="gameControls"><button id="chessAI">Z KINDLE'EM</button><button id="chessTwo">2 OSOBY</button><select id="chessLevel" class="levelSelect"><option value="veryeasy">bardzo łatwy</option><option value="easy">łatwy</option><option value="medium" selected>średni</option><option value="hard">trudny</option></select><button id="chessUndo">COFNIJ</button></div><div id="chessClockPanel" class="chessClockPanel hidden"><select id="chessTime"><option value="0" selected>BEZ ZEGARA</option><option value="180">3 MINUTY</option><option value="300">5 MINUT</option><option value="600">10 MINUT</option></select><span id="chessWhiteClock">BIAŁE 05:00</span><span id="chessBlackClock">CZARNE 05:00</span></div><div id="chessSettings" class="settingsPanel hidden"><button class="closeSettings">ZAMKNIJ</button><label class="option">Figury <select id="chessStyle"><option value="symbols">symbole</option><option value="letters">litery</option></select></label><p class="hint">Roszada, en passant, szach, mat i pat. Promocja do hetmana.</p></div><div id="chessBoard" class="gameBoard8"></div></div>
<div id="checkers" class="page"><div class="bar"><span id="checkersStatus"></span><button id="checkersNew" class="small">NOWA</button><button class="small settingsToggle" data-panel="checkersSettings">USTAWIENIA</button></div><div class="gameControls"><button id="checkersAI">Z KINDLE'EM</button><button id="checkersTwo">2 OSOBY</button><select id="checkersLevel" class="levelSelect"><option value="veryeasy">bardzo łatwy</option><option value="easy">łatwy</option><option value="medium" selected>średni</option><option value="hard">trudny</option></select></div><div id="checkersSettings" class="settingsPanel hidden"><button class="closeSettings">ZAMKNIJ</button><label class="option">Pionki <select id="checkersStyle"><option value="round">okrągłe</option><option value="flat">płaskie</option></select></label><p class="hint">Bicie jest obowiązkowe. K oznacza damkę.</p></div><div id="checkersBoard" class="gameBoard8"></div></div>
<div id="connect" class="page"><div class="bar"><span id="connectStatus"></span><button id="connectNew" class="small">NOWA</button></div><div class="gameControls"><button id="connectAI">Z KINDLE'EM</button><button id="connectTwo">2 OSOBY</button><select id="connectLevel" class="levelSelect"><option value="veryeasy">bardzo łatwy</option><option value="easy">łatwy</option><option value="medium" selected>średni</option><option value="hard">trudny</option></select></div><div id="connectBoard" class="connectBoard"></div></div>
<div id="lights" class="page"><div class="bar"><span id="lightsStatus"></span><button id="lightsNew" class="small">NOWA</button><button class="small settingsToggle" data-panel="lightsSettings">ZASADY</button></div><div id="lightsSettings" class="settingsPanel hidden"><p class="hint">Dotknięcie zmienia pole i sąsiadów. Zgaś wszystkie.</p></div><div id="lightsBoard" class="lightsBoard"></div></div>
<div id="life" class="page"><div class="bar"><span id="lifeStatus">Pokolenie: 0</span><button id="lifeClear" class="small">WYCZYŚĆ</button><button id="lifeStep" class="small">KROK</button><button id="lifeRun" class="small darkButton">START</button><button class="small settingsToggle" data-panel="lifeSettings">USTAWIENIA</button></div><div id="lifeSettings" class="settingsPanel hidden"><label class="option">Cel <select id="lifeGoal"><option value="10">10 pokoleń</option><option value="25" selected>25 pokoleń</option><option value="50">50 pokoleń</option><option value="100">100 pokoleń</option><option value="0">BEZ KOŃCA</option></select></label><label class="option">Układ <select id="lifePreset"><option value="empty">pusty</option><option value="glider">szybowiec</option><option value="beacon">latarnia</option><option value="pulsar">pulsar</option><option value="random">losowy</option></select></label><button id="lifeLoadPreset" class="wideSmall">WCZYTAJ UKŁAD</button></div><p class="hint">Dotykaj pól albo wybierz gotowy układ.</p><div id="lifeBoard" class="lifeBoard"></div></div>
<div id="writer" class="page"><div class="bar"><span>KINDLEWRITER</span><button id="writerNew" class="small">NOWY</button><button id="writerExport" class="small">PLIK TXT</button><button id="writerSave" class="small darkButton">ZAPISZ</button></div><input id="writerTitle" class="textInput" placeholder="Tytuł dokumentu"><div class="formatBar"><button data-cmd="bold"><b>B</b></button><button data-cmd="italic"><i>I</i></button><button data-cmd="underline"><u>U</u></button><button data-cmd="insertUnorderedList">• LISTA</button><button data-cmd="formatBlock" data-value="h2">NAGŁÓWEK</button></div><div id="writerEditor" contenteditable="true"></div><div id="writerDocs"></div></div>
<div id="draw" class="page"><div class="bar"><span>SZKICOWNIK</span><button id="drawSave" class="small darkButton">ZAPISZ PNG</button><button id="drawClear" class="small">WYCZYŚĆ</button></div><div id="drawTools" class="drawTools"><button data-color="#000000" class="selected">CZARNY</button><button data-color="#555555">CIEMNY</button><button data-color="#999999">SZARY</button><button data-color="#dddddd">JASNY</button><button id="drawEraser">GUMKA</button><select id="drawWidth"><option value="3">CIENKA</option><option value="6" selected>ŚREDNIA</option><option value="12">GRUBA</option></select></div><canvas id="drawCanvas" width="600" height="650"></canvas><div id="drawSaved"></div></div>
<div id="todo" class="page"><div class="bar"><span>LISTA ZADAŃ</span><button id="todoClear" class="small">USUŃ GOTOWE</button></div><div class="inputRow"><input id="todoInput" class="textInput" placeholder="Nowe zadanie"><button id="todoAdd">DODAJ</button></div><div id="todoList"></div></div>
<div id="calc" class="page"><div class="bar"><span>KALKULATOR</span><button id="calcMode" class="small">NAUKOWY</button></div><input id="calcDisplay" class="calcDisplay" readonly><div id="calcScientific" class="calcScientific hidden"></div><div id="calcKeys" class="calcKeys"></div></div>
<div id="files" class="page"><div class="bar"><span>PLIKI PRZEZ WI-FI</span></div><div class="updateBox"><h2>Telefon → Kindle</h2><p>Telefon i Kindle muszą być połączone z tą samą siecią Wi-Fi.</p><button id="filesStart" class="wideUpdate darkButton">URUCHOM SERWER</button><button id="filesStatus" class="wideUpdate">POKAŻ ADRES I PIN</button><button id="filesStop" class="wideUpdate">WYŁĄCZ SERWER</button><p id="filesInfo">Po uruchomieniu otwórz pokazany adres w przeglądarce telefonu.</p><p class="hint">Pliki zostaną zapisane w documents/Uploads. Serwer wyłącz po zakończeniu przesyłania.</p></div></div>
<div id="updates" class="page"><div class="bar"><span>AKTUALIZACJE</span></div><div class="updateBox"><h2>InkDeck <span id="updateCurrent">3.5.2</span></h2><p id="updateStatus">Połącz Kindle z Wi-Fi i sprawdź dostępność nowej wersji.</p><button id="updateCheck" class="wideUpdate">SPRAWDŹ GITHUB</button><button id="updateInstall" class="wideUpdate darkButton">POBIERZ I ZAINSTALUJ</button><p class="hint">Aktualizacja jest sprawdzana sumą SHA-256. W razie błędu obecna wersja zostaje zachowana.</p></div></div>
<div id="plugins" class="page"><div class="bar"><span>PLUGINY</span></div><p class="hint">Pluginy są wczytywane z documents/InkDeck/plugins. Mogą dodawać gry i narzędzia.</p><div id="pluginList"></div></div>
<script>window.InkDeck={plugins:[],register:function(p){if(p&&p.id&&p.name&&p.open)this.plugins.push(p);}};</script><script src="app.js"></script><script src="plugins-loader.js"></script><script>if(window.InkDeck&&InkDeck.renderPlugins)InkDeck.renderPlugins();</script></body></html>
