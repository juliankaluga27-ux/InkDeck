<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>InkDeck Pliki</title>
  <style>
    body{max-width:680px;margin:30px auto;padding:20px;font-family:Arial,sans-serif;background:#f4f4f4;color:#111}
    main{padding:24px;border:3px solid #111;background:#fff}h1{margin-top:0}label{display:block;margin:18px 0 6px;font-weight:bold}
    input,button{box-sizing:border-box;width:100%;min-height:52px;padding:10px;border:2px solid #111;background:#fff;font-size:18px}
    button{margin-top:18px;background:#111;color:#fff;font-weight:bold}#status{white-space:pre-wrap;margin-top:18px;padding:12px;border:1px solid #777}
  </style>
</head>
<body><main><h1>InkDeck — pliki</h1><p>Wybierz pliki z telefonu. Trafią do folderu <b>documents/Uploads</b> na Kindle.</p>
<label for="pin">PIN pokazany na Kindle</label><input id="pin" inputmode="numeric" maxlength="4">
<label for="files">Pliki</label><input id="files" type="file" multiple>
<button id="send">WYŚLIJ NA KINDLE</button><div id="status">Gotowe.</div></main>
<script>
(function(){var button=document.getElementById('send'),status=document.getElementById('status');function safeName(name){return name.replace(/[^A-Za-z0-9._-]/g,'_').replace(/^\.+/,'plik-');}button.onclick=function(){var pin=document.getElementById('pin').value,files=document.getElementById('files').files,i=0;if(!/^\d{4}$/.test(pin)){status.textContent='Wpisz czterocyfrowy PIN.';return;}if(!files.length){status.textContent='Wybierz co najmniej jeden plik.';return;}button.disabled=true;function next(){var file,xhr;if(i>=files.length){status.textContent+='\nZakończono.';button.disabled=false;return;}file=files[i++];status.textContent='Wysyłanie '+file.name+' ('+i+'/'+files.length+')...';xhr=new XMLHttpRequest();xhr.open('POST','/cgi-bin/upload.sh?pin='+pin+'&name='+encodeURIComponent(safeName(file.name)),true);xhr.onload=function(){status.textContent+= '\n'+xhr.responseText;next();};xhr.onerror=function(){status.textContent+='\nBłąd połączenia.';button.disabled=false;};xhr.send(file);}next();};})();
</script></body></html>
